# ============================================
# Góp — biến môi trường cho API NestJS
# ============================================
# Copy this file to .env and fill in the values.

# ── Database ──────────────────────────────────
# Docker riêng cho luồng dùng chung: infra/docker/compose-connected.yml.
DATABASE_URL=postgresql://gop_dev:gop_dev_local_only@127.0.0.1:55434/gop_connected?schema=public

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (JWT) ────────────────────────────────
# Tạo hai chuỗi ngẫu nhiên khác nhau, không dùng nguyên giá trị ví dụ khi chạy thật.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Backend ───────────────────────────────────
API_PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3102

# ── Frontend ──────────────────────────────────
# Phần web dùng chung đọc URL API ở server qua GOP_BACKEND_URL trong apps/web/.env.local.

# ── Stripe (Phase sau) ───────────────────────
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── AI Service (Phase sau) ───────────────────
# AI_SERVICE_URL=http://localhost:8000
# AI_SERVICE_API_KEY=xxx

# ── File Upload ──────────────────────────────
# S3_BUCKET=crowdfunding-media
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY_ID=xxx
# S3_SECRET_ACCESS_KEY=xxx

# ── Email (SMTP) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

