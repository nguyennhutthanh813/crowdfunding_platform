# ============================================
# Crowdfunding Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/crowdfunding_dev

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (JWT) ────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-another-random-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Backend ───────────────────────────────────
API_PORT=3001
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_NAME=Crowdfunding Platform

# ── Stripe (Phase sau) ───────────────────────
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── AI Service (Phase sau) ───────────────────
# AI_SERVICE_URL=http://localhost:8000
# AI_SERVICE_API_KEY=xxx

# ── File Upload ──────────────────────────────
# S3_BUCKET=crowdfunding-media
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY_ID=xxx
# S3_SECRET_ACCESS_KEY=xxx

# ── Email (SMTP) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Nền tảng Góp <your_email@gmail.com>"

