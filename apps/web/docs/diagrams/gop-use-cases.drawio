ica;spacing=10;" vertex="1" parent="1"><mxGeometry x="330" y="880" width="760" height="105" as="geometry"/></mxCell><mxCell id="admin-system-worker-note-59" value="Worker chốt campaign idempotent: đạt Goal → capture; không đạt → cancel. Webhook provider xử lý theo event ID duy nhất." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#F4F8E4;strokeColor=#8A8350;fontColor=#102A22;fontSize=12;fontFamily=Helvetica;spacing=10;" vertex="1" parent="1"><mxGeometry x="1240" y="980" width="800" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
