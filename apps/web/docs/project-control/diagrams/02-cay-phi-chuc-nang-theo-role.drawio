<mxfile host="app.diagrams.net" modified="2026-09-13T00:00:00.000Z" agent="Gop student project" version="24.7.17" type="device" pages="1"><diagram id="02-cay-phi-chuc-nang-theo-role" name="CÂY YÊU CẦU PHI CHỨC NĂNG THEO VAI TRÒ"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="2040" math="0" shadow="0" background="#FBFAF6"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="02-cay-phi-chuc-nang-theo-role-title-1" value="&lt;b&gt;CÂY YÊU CẦU PHI CHỨC NĂNG THEO VAI TRÒ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6C64&quot; style=&quot;font-size:14px&quot;&gt;Mỗi nhánh có tiêu chí kiểm tra được; đây là target để test, không phải lời tuyên bố đã hoàn thành&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#15352B;fontSize=28;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="55" y="20" width="1930" height="62" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-root-2" value="&lt;b&gt;GÓP CROWDFUNDING PLATFORM&lt;/b&gt;&lt;br&gt;Web responsive · dữ liệu VND · nhóm 2 sinh viên" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#15352B;strokeColor=#15352B;fontColor=#FFFFFF;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="670" y="100" width="700" height="88" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-role-0-3" value="&lt;b&gt;GUEST&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E7F0F6;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="610" height="72" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-root-2" target="02-cay-phi-chuc-nang-theo-role-role-0-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-group-0-0-5" value="&lt;b&gt;TÌM THẤY &amp; ĐỌC ĐƯỢC · NFR-G01&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Metadata rõ cho trang public&lt;br&gt;• Nội dung chính dùng semantic heading&lt;br&gt;• Ảnh có alt; bàn phím đi được luồng chính" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="610" height="170" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-role-0-3" target="02-cay-phi-chuc-nang-theo-role-group-0-0-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-group-0-1-7" value="&lt;b&gt;NHANH &amp; AN TOÀN · NFR-G02&lt;/b&gt;&lt;br&gt;&lt;br&gt;• LCP public target ≤ 2,5 giây&lt;br&gt;• Chỉ lộ dữ liệu campaign công khai&lt;br&gt;• 390/768/1440 px không tràn ngang" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="526" width="610" height="170" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-role-0-3" target="02-cay-phi-chuc-nang-theo-role-group-0-1-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-role-1-9" value="&lt;b&gt;BACKER&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E8F1D8;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="245" width="610" height="72" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-root-2" target="02-cay-phi-chuc-nang-theo-role-role-1-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-group-1-0-11" value="&lt;b&gt;TIN CẬY THANH TOÁN · NFR-B01&lt;/b&gt;&lt;br&gt;&lt;br&gt;• AUTHORIZED = giữ hạn mức, chưa thu&lt;br&gt;• Tổng tiền tính lại ở server&lt;br&gt;• Một pledge/campaign/backer và snapshot giá" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="340" width="610" height="170" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-role-1-9" target="02-cay-phi-chuc-nang-theo-role-group-1-0-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-group-1-1-13" value="&lt;b&gt;DỄ DÙNG &amp; RIÊNG TƯ · NFR-B02&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Validation theo từng bước, giữ bản nhập&lt;br&gt;• Địa chỉ chỉ Việt Nam, che thông tin thẻ&lt;br&gt;• Draft tin nhắn và tab không mất khi chuyển qua lại" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="526" width="610" height="170" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-role-1-9" target="02-cay-phi-chuc-nang-theo-role-group-1-1-13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-role-2-15" value="&lt;b&gt;CREATOR&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FBE7DF;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="245" width="610" height="72" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-root-2" target="02-cay-phi-chuc-nang-theo-role-role-2-15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-group-2-0-17" value="&lt;b&gt;SOẠN DỮ LIỆU AN TOÀN · NFR-C01&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Có lưu nháp và phản hồi thành công/lỗi&lt;br&gt;• Giới hạn độ dài, tiền VND, duration&lt;br&gt;• Ảnh tối ưu và có mô tả thay thế" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="340" width="610" height="170" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-role-2-15" target="02-cay-phi-chuc-nang-theo-role-group-2-0-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-group-2-1-19" value="&lt;b&gt;AI GIẢI THÍCH ĐƯỢC · NFR-C02&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Có model version và input snapshot&lt;br&gt;• Probability đi cùng factors, không nói chắc chắn&lt;br&gt;• Không biến dự báo thành lời cam kết kết quả" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="526" width="610" height="170" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-role-2-15" target="02-cay-phi-chuc-nang-theo-role-group-2-1-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-group-2-2-21" value="&lt;b&gt;TRỢ LÝ CÓ KIỂM SOÁT · NFR-C03&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Prompt version + input snapshot&lt;br&gt;• Nội dung người dùng luôn được coi là dữ liệu&lt;br&gt;• Gợi ý chỉ điền nháp, cần người duyệt" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="712" width="610" height="170" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-role-2-15" target="02-cay-phi-chuc-nang-theo-role-group-2-2-21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-role-3-23" value="&lt;b&gt;COLLABORATOR&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EEE9F8;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1140" width="610" height="72" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-root-2" target="02-cay-phi-chuc-nang-theo-role-role-3-23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-group-3-0-25" value="&lt;b&gt;QUYỀN TỐI THIỂU · NFR-CO01&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Kiểm tra quyền tại API, không chỉ ẩn nút&lt;br&gt;• Giao câu hỏi theo campaign_id + user_id&lt;br&gt;• Badge phản ánh đúng vai trò trong campaign" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="1235" width="610" height="170" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-role-3-23" target="02-cay-phi-chuc-nang-theo-role-group-3-0-25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-group-3-1-27" value="&lt;b&gt;PHỐI HỢP RÕ · NFR-CO02&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Task/câu hỏi có người nhận và trạng thái&lt;br&gt;• Câu hỏi giao lại tạo lượt đọc mới đúng người&lt;br&gt;• Bàn giao để lại mốc thời gian&lt;br&gt;• Thao tác lỗi vẫn giữ nội dung đang làm" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="1421" width="610" height="170" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-role-3-23" target="02-cay-phi-chuc-nang-theo-role-group-3-1-27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-role-4-29" value="&lt;b&gt;ADMIN&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F4E8E6;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="1140" width="610" height="72" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-root-2" target="02-cay-phi-chuc-nang-theo-role-role-4-29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-group-4-0-31" value="&lt;b&gt;AUDIT &amp; HUMAN-IN-THE-LOOP · NFR-A01&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Quyết định luôn có admin, lý do, timestamp&lt;br&gt;• Fraud score chỉ xếp thứ tự xem xét&lt;br&gt;• Không công khai IP/device thô" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="1235" width="610" height="170" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-role-4-29" target="02-cay-phi-chuc-nang-theo-role-group-4-0-31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-group-4-1-33" value="&lt;b&gt;VẬN HÀNH ỔN ĐỊNH · NFR-A02&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Review có SLA và trạng thái quá hạn&lt;br&gt;• Đối soát payment có mốc chốt dữ liệu&lt;br&gt;• Bộ lọc, form và quyết định giữ khi đổi tab" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="1421" width="610" height="170" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-role-4-29" target="02-cay-phi-chuc-nang-theo-role-group-4-1-33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-role-5-35" value="&lt;b&gt;SHARED / WORKER&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EEF1EF;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="1140" width="610" height="72" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-root-2" target="02-cay-phi-chuc-nang-theo-role-role-5-35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-group-5-0-37" value="&lt;b&gt;NỀN TẢNG · NFR-S01&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Next.js deploy Vercel, không phụ thuộc disk runtime&lt;br&gt;• UI chỉ phụ thuộc PlatformApi contract&lt;br&gt;• VND, vi-VN và múi giờ Asia/Ho_Chi_Minh" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="1235" width="610" height="170" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-role-5-35" target="02-cay-phi-chuc-nang-theo-role-group-5-0-37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-group-5-1-39" value="&lt;b&gt;RELIABILITY &amp; SECURITY · NFR-S02&lt;/b&gt;&lt;br&gt;&lt;br&gt;• RBAC, validate input, secret chỉ ở server&lt;br&gt;• Webhook/job idempotent, retry có giới hạn&lt;br&gt;• Loading/empty/error/fallback cho API, AI, payment" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="1421" width="610" height="170" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-role-5-35" target="02-cay-phi-chuc-nang-theo-role-group-5-1-39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-group-5-2-41" value="&lt;b&gt;QUALITY GATE · NFR-S03&lt;/b&gt;&lt;br&gt;&lt;br&gt;• TypeScript + ESLint + production build&lt;br&gt;• E2E hai nhánh Successful/Failed&lt;br&gt;• Test desktop, tablet, mobile và keyboard" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="1607" width="610" height="170" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-edge-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="02-cay-phi-chuc-nang-theo-role-role-5-35" target="02-cay-phi-chuc-nang-theo-role-group-5-2-41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="02-cay-phi-chuc-nang-theo-role-note-43" value="&lt;b&gt;Quy ước đọc:&lt;/b&gt; nhánh role cho biết ai dùng; mã UC/NFR dùng để truy vết; dữ liệu và trạng thái phải nhất quán xuyên các workspace." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF7D8;strokeColor=#8E8250;fontColor=#15352B;fontSize=13;fontFamily=Arial;spacing=12;" vertex="1" parent="1"><mxGeometry x="300" y="1870" width="1440" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
