# URL dùng cho metadata và ảnh chia sẻ.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Đường dẫn file SQLite (mặc định .data/fundviet.sqlite). Xoá file để tạo lại dữ liệu demo.
# FUNDVIET_DB_FILE=.data/fundviet.sqlite

# Bộ lập lịch tự chốt chiến dịch (mở SCHEDULED, chốt LIVE hết hạn). Đặt 0 để tắt chạy tự động.
# FUNDVIET_AUTO_SCHEDULER=1
