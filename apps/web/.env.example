# Khóa server ngẫu nhiên tối thiểu 32 ký tự, bắt buộc khi pnpm start hoặc deploy.
# Không đưa giá trị thật lên Git. next dev dùng khóa tạm nếu biến này để trống.
GOP_SESSION_SECRET=

# URL dùng cho metadata, sitemap và ảnh chia sẻ. Vercel Preview có thể để trống.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# pnpm dev bật SQLite local mặc định (Node.js 24+). Đặt 0 để dùng cookie demo như bản Vercel.
# GOP_LOCAL_DB=0
