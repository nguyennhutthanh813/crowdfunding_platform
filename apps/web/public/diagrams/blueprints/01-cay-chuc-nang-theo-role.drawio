<mxfile host="app.diagrams.net" modified="2026-09-13T00:00:00.000Z" agent="Gop student project" version="24.7.17" type="device" pages="1"><diagram id="01-cay-chuc-nang-theo-role" name="CÂY CHỨC NĂNG THEO VAI TRÒ"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="2040" math="0" shadow="0" background="#FBFAF6"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="01-cay-chuc-nang-theo-role-title-1" value="&lt;b&gt;CÂY CHỨC NĂNG THEO VAI TRÒ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6C64&quot; style=&quot;font-size:14px&quot;&gt;Bám 54 Use Case đã chốt · phần mở rộng được ghi riêng, không trộn với luồng bắt buộc&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#15352B;fontSize=28;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="55" y="20" width="1930" height="62" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-root-2" value="&lt;b&gt;GÓP CROWDFUNDING PLATFORM&lt;/b&gt;&lt;br&gt;Web responsive · dữ liệu VND · nhóm 2 sinh viên" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#15352B;strokeColor=#15352B;fontColor=#FFFFFF;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="670" y="100" width="700" height="88" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-role-0-3" value="&lt;b&gt;GUEST&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E7F0F6;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="610" height="72" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-root-2" target="01-cay-chuc-nang-theo-role-role-0-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-0-0-5" value="&lt;b&gt;KHÁM PHÁ CÔNG KHAI · G01–G03&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Trang chủ và chiến dịch nổi bật&lt;br&gt;• Tìm kiếm, category và bộ lọc&lt;br&gt;• Project Detail đủ 7 tab" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-0-3" target="01-cay-chuc-nang-theo-role-group-0-0-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-0-1-7" value="&lt;b&gt;TÀI KHOẢN · G04–G05&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Đăng ký Backer mặc định&lt;br&gt;• Đăng nhập, đăng xuất, khôi phục mật khẩu" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="526" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-0-3" target="01-cay-chuc-nang-theo-role-group-0-1-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-role-1-9" value="&lt;b&gt;BACKER&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E8F1D8;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="245" width="610" height="72" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-root-2" target="01-cay-chuc-nang-theo-role-role-1-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-1-0-11" value="&lt;b&gt;CÁ NHÂN HÓA · B01–B05&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Chọn sở thích lúc onboarding&lt;br&gt;• Nhận Top-N Recommendation có lý do&lt;br&gt;• Save campaign, Follow Creator, Notify me" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="340" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-1-9" target="01-cay-chuc-nang-theo-role-group-1-0-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-1-1-13" value="&lt;b&gt;PLEDGE 4 BƯỚC · B06–B10&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Reward hoặc không nhận quà&lt;br&gt;• Add-on, địa chỉ Việt Nam, shipping&lt;br&gt;• Kiểm tra tổng tiền và authorize" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="526" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-1-9" target="01-cay-chuc-nang-theo-role-group-1-1-13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-1-2-15" value="&lt;b&gt;SAU KHI ỦNG HỘ · B11–B16&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Đặt câu hỏi, đọc phản hồi của nhóm&lt;br&gt;• Backed, Saved, Following, Activity&lt;br&gt;• Pledge ID nối Backer → Creator → ngày chốt" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="712" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-1-9" target="01-cay-chuc-nang-theo-role-group-1-2-15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-role-2-17" value="&lt;b&gt;CREATOR&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FBE7DF;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="245" width="610" height="72" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-root-2" target="01-cay-chuc-nang-theo-role-role-2-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-2-0-19" value="&lt;b&gt;SOẠN CHIẾN DỊCH · C01–C06&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Draft, Story, ảnh minh họa mẫu, Risks&lt;br&gt;• Goal 15–60 ngày, Reward, Add-on, shipping&lt;br&gt;• Mời và phân quyền Collaborator theo campaign" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="340" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-2-17" target="01-cay-chuc-nang-theo-role-group-2-0-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-2-1-21" value="&lt;b&gt;DỰ BÁO &amp; VÒNG ĐỜI · C07–C12&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Success Prediction và factors&lt;br&gt;• Gửi duyệt, nhận phản hồi, Pre-launch&lt;br&gt;• Launch, funding metric và live prediction" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="526" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-2-17" target="01-cay-chuc-nang-theo-role-group-2-1-21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-2-2-23" value="&lt;b&gt;VẬN HÀNH · C13–C15&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Trả lời hoặc giao câu hỏi đúng thành viên&lt;br&gt;• Giao quà chỉ mở sau Successful&lt;br&gt;• Task/handoff nối Creator với Collaborator" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="712" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-2-17" target="01-cay-chuc-nang-theo-role-group-2-2-23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-2-3-25" value="&lt;b&gt;SAU CORE · EXT-C01–EXT-C03&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Hỗ trợ rà tiêu đề và nội dung bản nháp&lt;br&gt;• Gom chủ đề/cảm xúc của bình luận&lt;br&gt;• Quick Reply chỉ điền nháp, người dùng tự gửi" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="898" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-2-17" target="01-cay-chuc-nang-theo-role-group-2-3-25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-role-3-27" value="&lt;b&gt;COLLABORATOR&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EEE9F8;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1140" width="610" height="72" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-root-2" target="01-cay-chuc-nang-theo-role-role-3-27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-3-0-29" value="&lt;b&gt;QUYỀN THEO CAMPAIGN · C06&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Được Creator mời vào đúng chiến dịch&lt;br&gt;• Quyền tách: update, reply, xem dự báo&lt;br&gt;• Không có quyền launch, phí hoặc thành viên" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="1235" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-3-27" target="01-cay-chuc-nang-theo-role-group-3-0-29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-3-1-31" value="&lt;b&gt;BÀN LÀM VIỆC · C12–C14&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Xem task, câu hỏi được giao, deadline&lt;br&gt;• Thông báo trong app, đánh dấu đã đọc&lt;br&gt;• Theo dõi live prediction&lt;br&gt;• Cập nhật quay về Creator trước khi tới Backer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="1421" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-3-27" target="01-cay-chuc-nang-theo-role-group-3-1-31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-role-4-33" value="&lt;b&gt;ADMIN&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F4E8E6;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="1140" width="610" height="72" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-root-2" target="01-cay-chuc-nang-theo-role-role-4-33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-4-0-35" value="&lt;b&gt;KIỂM DUYỆT · A01–A04&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Hàng chờ, version, tài liệu, SLA&lt;br&gt;• Checklist và bằng chứng&lt;br&gt;• Kết quả + lý do quay về đúng campaign" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="1235" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-4-33" target="01-cay-chuc-nang-theo-role-group-4-0-35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-4-1-37" value="&lt;b&gt;VẬN HÀNH SÀN · A05–A07&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Khóa/mở người dùng có lý do&lt;br&gt;• Dòng vốn, doanh thu, đối soát&lt;br&gt;• Phí nền tảng và nhật ký thay đổi" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="1421" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-4-33" target="01-cay-chuc-nang-theo-role-group-4-1-37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-4-2-39" value="&lt;b&gt;FRAUD REVIEW · A08–A10&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Hàng chờ theo risk score&lt;br&gt;• Signals/evidence đã che dữ liệu nhạy cảm&lt;br&gt;• Clear hoặc Escalate, không tự khóa bằng AI" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="1607" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-4-33" target="01-cay-chuc-nang-theo-role-group-4-2-39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-role-5-41" value="&lt;b&gt;SYSTEM / WORKER&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EEF1EF;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="1140" width="610" height="72" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-root-2" target="01-cay-chuc-nang-theo-role-role-5-41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-5-0-43" value="&lt;b&gt;DỮ LIỆU &amp; AI · S01–S03&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Tổng hợp metric và interaction hằng ngày&lt;br&gt;• Chạy live prediction cho campaign&lt;br&gt;• Chấm fraud score và tạo evidence tổng hợp" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="1235" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-5-41" target="01-cay-chuc-nang-theo-role-group-5-0-43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-group-5-1-45" value="&lt;b&gt;CHỐT CAMPAIGN · S04–S08&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Đạt Goal: capture; không đạt: cancel&lt;br&gt;• Webhook idempotent theo provider event ID&lt;br&gt;• Gửi thông báo kết quả và lỗi cần xử lý" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="1421" width="610" height="170" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-edge-46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="01-cay-chuc-nang-theo-role-role-5-41" target="01-cay-chuc-nang-theo-role-group-5-1-45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="01-cay-chuc-nang-theo-role-note-47" value="&lt;b&gt;Quy ước đọc:&lt;/b&gt; nhánh role cho biết ai dùng; mã UC/NFR dùng để truy vết; dữ liệu và trạng thái phải nhất quán xuyên các workspace." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF7D8;strokeColor=#8E8250;fontColor=#15352B;fontSize=13;fontFamily=Arial;spacing=12;" vertex="1" parent="1"><mxGeometry x="300" y="1870" width="1440" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
