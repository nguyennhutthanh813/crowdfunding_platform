<mxfile host="app.diagrams.net" modified="2026-09-13T00:00:00.000Z" agent="Gop student project" version="24.7.17" type="device" pages="1"><diagram id="03-cay-ui-ux-theo-role" name="CÂY UI/UX VÀ MÀN HÌNH THEO VAI TRÒ"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="2040" math="0" shadow="0" background="#FBFAF6"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="03-cay-ui-ux-theo-role-title-1" value="&lt;b&gt;CÂY UI/UX VÀ MÀN HÌNH THEO VAI TRÒ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5A6C64&quot; style=&quot;font-size:14px&quot;&gt;Mỗi workspace có nhịp dùng và hệ màu riêng, nhưng cùng chia sẻ một câu chuyện dữ liệu ORBIT&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#15352B;fontSize=28;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="55" y="20" width="1930" height="62" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-root-2" value="&lt;b&gt;GÓP CROWDFUNDING PLATFORM&lt;/b&gt;&lt;br&gt;Web responsive · dữ liệu VND · nhóm 2 sinh viên" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#15352B;strokeColor=#15352B;fontColor=#FFFFFF;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="670" y="100" width="700" height="88" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-role-0-3" value="&lt;b&gt;GUEST · KHÔNG GIAN KHÁM PHÁ&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E7F0F6;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="610" height="72" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-root-2" target="03-cay-ui-ux-theo-role-role-0-3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-0-0-5" value="&lt;b&gt;KHÁM PHÁ&lt;/b&gt;&lt;br&gt;&lt;br&gt;• / · featured, category, dự án thật Việt Nam&lt;br&gt;• /discover · search, status, category, sort&lt;br&gt;• Project cards: trạng thái, tiến độ, lý do nổi bật" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-0-3" target="03-cay-ui-ux-theo-role-group-0-0-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-0-1-7" value="&lt;b&gt;TIN CẬY TRƯỚC KHI THAM GIA&lt;/b&gt;&lt;br&gt;&lt;br&gt;• /projects/[slug] · 7 tab&lt;br&gt;• /auth · login/register + 4 tài khoản nhanh&lt;br&gt;• Empty/error/loading và CTA đúng trạng thái" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="526" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-0-3" target="03-cay-ui-ux-theo-role-group-0-1-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-role-1-9" value="&lt;b&gt;BACKER · SỔ ỦNG HỘ&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#E8F1D8;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="245" width="610" height="72" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-root-2" target="03-cay-ui-ux-theo-role-role-1-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-1-0-11" value="&lt;b&gt;VÀO HỆ THỐNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;• /onboarding · chọn sở thích cold-start&lt;br&gt;• Home recommendation có lý do&lt;br&gt;• Header tìm dự án; sidebar có Saved/Following" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="340" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-1-9" target="03-cay-ui-ux-theo-role-group-1-0-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-1-1-13" value="&lt;b&gt;ỦNG HỘ&lt;/b&gt;&lt;br&gt;&lt;br&gt;• /pledge/[slug] · Reward → Add-on → Địa chỉ → Thẻ&lt;br&gt;• Sticky summary và breakdown VND&lt;br&gt;• Kết quả AUTHORIZED · CHƯA THU" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="526" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-1-9" target="03-cay-ui-ux-theo-role-group-1-1-13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-1-2-15" value="&lt;b&gt;THEO DÕI SAU ĐÓ&lt;/b&gt;&lt;br&gt;&lt;br&gt;• /dashboard · Backed/Saved/Following&lt;br&gt;• Messages/Activity/Settings + việc cần xác nhận&lt;br&gt;• Hiện Minh Anh → hạn mức → ORBIT → ngày chốt" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="712" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-1-9" target="03-cay-ui-ux-theo-role-group-1-2-15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-role-2-17" value="&lt;b&gt;CREATOR · XƯỞNG CHIẾN DỊCH&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FBE7DF;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="245" width="610" height="72" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-root-2" target="03-cay-ui-ux-theo-role-role-2-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-2-0-19" value="&lt;b&gt;TỔNG QUAN&lt;/b&gt;&lt;br&gt;&lt;br&gt;• /creator · funding hôm nay, pace, forecast&lt;br&gt;• Header có tiến độ; sidebar theo vận hành&lt;br&gt;• CTA đi thẳng tới đúng vùng cần xử lý" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="340" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-2-17" target="03-cay-ui-ux-theo-role-group-2-0-19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-2-1-21" value="&lt;b&gt;SOẠN &amp; DỰ BÁO&lt;/b&gt;&lt;br&gt;&lt;br&gt;• /creator/campaigns/new · wizard 5 bước&lt;br&gt;• Ảnh demo có nhãn, chưa nhận tệp upload&lt;br&gt;• /creator/ai · score, factors, model card&lt;br&gt;• Content helper là nhánh mở rộng có nhãn rõ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="526" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-2-17" target="03-cay-ui-ux-theo-role-group-2-1-21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-2-2-23" value="&lt;b&gt;VẬN HÀNH CAMPAIGN&lt;/b&gt;&lt;br&gt;&lt;br&gt;• /creator/.../manage · Overview/Team/Community/Fulfillment&lt;br&gt;• Hiện hồ sơ → cam kết → task nhóm → ngày chốt&lt;br&gt;• Giao câu hỏi cho người có quyền; quà theo trạng thái" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="712" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-2-17" target="03-cay-ui-ux-theo-role-group-2-2-23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-role-3-25" value="&lt;b&gt;COLLABORATOR · BẢNG VIỆC NHÓM&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EEE9F8;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1140" width="610" height="72" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-root-2" target="03-cay-ui-ux-theo-role-role-3-25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-3-0-27" value="&lt;b&gt;VIỆC CỦA TÔI&lt;/b&gt;&lt;br&gt;&lt;br&gt;• /collaborator · task và câu hỏi của mình&lt;br&gt;• /account?tab=notifications · việc mới giao&lt;br&gt;• Bộ lọc open/done và nút hoàn tất&lt;br&gt;• Hiện Creator giao → Huy làm → nhóm nhận → Backer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="1235" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-3-25" target="03-cay-ui-ux-theo-role-group-3-0-27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-3-1-29" value="&lt;b&gt;LÀM TRONG CAMPAIGN&lt;/b&gt;&lt;br&gt;&lt;br&gt;• /collaborator/.../manage · chỉ tab được phép&lt;br&gt;• /collaborator/forecast · đọc dự báo&lt;br&gt;• Lọc câu của tôi, reply có badge và quyền" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="1421" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-3-25" target="03-cay-ui-ux-theo-role-group-3-1-29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-role-4-31" value="&lt;b&gt;ADMIN · BÀN KIỂM SOÁT&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F4E8E6;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="1140" width="610" height="72" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-root-2" target="03-cay-ui-ux-theo-role-role-4-31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-4-0-33" value="&lt;b&gt;CA TRỰC&lt;/b&gt;&lt;br&gt;&lt;br&gt;• /admin · due/overdue, authorization, support&lt;br&gt;• Header có ca trực, SLA và hàng chờ&lt;br&gt;• Hiện Creator gửi → AI xếp → Admin quyết định" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="1235" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-4-31" target="03-cay-ui-ux-theo-role-group-4-0-33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-4-1-35" value="&lt;b&gt;HÀNG CHỜ &amp; XỬ LÝ&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Reviews · version, documents, SLA, checklist&lt;br&gt;• Fraud · signals, note, Clear/Escalate&lt;br&gt;• Users · search, lock/unlock có lý do" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="1421" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-4-31" target="03-cay-ui-ux-theo-role-group-4-1-35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-4-2-37" value="&lt;b&gt;CẤU HÌNH CÓ KIỂM SOÁT&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Phí chỉ áp dụng campaign mới&lt;br&gt;• Suspend/restore campaign cần lý do&lt;br&gt;• Audit log giữ actor và thời gian" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="710" y="1607" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-4-31" target="03-cay-ui-ux-theo-role-group-4-2-37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-role-5-39" value="&lt;b&gt;NHẬN DIỆN GÓP · DÙNG CHUNG&lt;/b&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#EEF1EF;strokeColor=#15352B;strokeWidth=1.4;fontColor=#15352B;fontSize=17;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="1140" width="610" height="72" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-root-2" target="03-cay-ui-ux-theo-role-role-5-39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-5-0-41" value="&lt;b&gt;NHẬN DIỆN &amp; ĐIỀU HƯỚNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Logo Góp, tên tài khoản, role switcher&lt;br&gt;• Mỗi role có cấu trúc header/sidebar riêng&lt;br&gt;• Desktop nav + mobile menu, focus rõ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="1235" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-5-39" target="03-cay-ui-ux-theo-role-group-5-0-41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-5-1-43" value="&lt;b&gt;TRẠNG THÁI CHUNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Skeleton/loading, empty có hướng đi tiếp&lt;br&gt;• Inline validation, status/alert có aria-live&lt;br&gt;• Không dùng số liệu trang trí không có nguồn" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="1421" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-5-39" target="03-cay-ui-ux-theo-role-group-5-1-43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-group-5-2-45" value="&lt;b&gt;CÂU CHUYỆN DỮ LIỆU&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Panel liên vai trò hiện ngay trên 4 workspace&lt;br&gt;• Minh Anh ↔ pledge ORBIT ↔ Creator reservation&lt;br&gt;• Huy ↔ task ↔ Creator; Admin ↔ review/audit" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=16;spacingLeft=16;spacingRight=14;fillColor=#FFFFFF;strokeColor=#AAB8B1;strokeWidth=1.3;fontColor=#15352B;fontSize=13;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="1607" width="610" height="170" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-edge-46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A6C64;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="03-cay-ui-ux-theo-role-role-5-39" target="03-cay-ui-ux-theo-role-group-5-2-45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="03-cay-ui-ux-theo-role-note-47" value="&lt;b&gt;Quy ước đọc:&lt;/b&gt; nhánh role cho biết ai dùng; mã UC/NFR dùng để truy vết; dữ liệu và trạng thái phải nhất quán xuyên các workspace." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF7D8;strokeColor=#8E8250;fontColor=#15352B;fontSize=13;fontFamily=Arial;spacing=12;" vertex="1" parent="1"><mxGeometry x="300" y="1870" width="1440" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
