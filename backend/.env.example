# =====================================================
# FundViet Backend — Environment Variables
# =====================================================
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ── Supabase Database ────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Điền chuỗi kết nối PostgreSQL từ Supabase (Connect -> Transaction/Session Pooler URI)
# Khi để trống ở local, backend tự động chạy trên SQLite (.data/fundviet.sqlite)
DATABASE_URL=

# ── JWT & 2FA Security ───────────────────────────────
JWT_SECRET=replace_with_64_char_random_secret
JWT_REFRESH_SECRET=replace_with_another_64_char_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
TOTP_ISSUER=FundViet

# ── Cloudinary Image Storage ─────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fundviet

# ── Email (Gmail SMTP / App Password) ────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="FundViet <your-email@gmail.com>"

# ── Email thông báo ──────────────────────────────────
# off = tắt hẳn email thông báo (vẫn gửi OTP). Để trống = bật.
EMAIL_NOTIFICATIONS=
# Tài khoản dữ liệu mẫu (id usr_...) chỉ nhận email nếu nằm trong danh sách này.
# Mặc định chỉ SMTP_USER. Tài khoản người dùng tự đăng ký luôn nhận email.
NOTIFY_EMAIL_ALLOWLIST=
