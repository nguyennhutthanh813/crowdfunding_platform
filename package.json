{
  "name": "fundviet-platform",
  "version": "1.0.0",
  "private": true,
  "description": "FundViet — Nền tảng gọi vốn cộng đồng (Backend REST API + Frontend Next.js)",
  "scripts": {
    "dev": "corepack pnpm --parallel -r dev",
    "dev:backend": "corepack pnpm --filter fundviet-backend dev",
    "dev:frontend": "corepack pnpm --filter fundviet-frontend dev",
    "build": "corepack pnpm --filter fundviet-backend compile && corepack pnpm --filter fundviet-frontend build",
    "build:backend": "corepack pnpm --filter fundviet-backend compile",
    "build:frontend": "corepack pnpm --filter fundviet-frontend build",
    "lint": "corepack pnpm -r lint",
    "type-check": "corepack pnpm -r type-check",
    "db:reset": "corepack pnpm --filter fundviet-backend db:reset",
    "db:sync-supabase": "corepack pnpm --filter fundviet-backend db:sync-supabase",
    "cloudinary:sync": "corepack pnpm --filter fundviet-backend cloudinary:sync",
    "test:backend": "corepack pnpm --filter fundviet-backend test",
    "deploy:vercel": "node .github/scripts/vercel-deploy.mjs --target=all --env=production"
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "turbo": "^2.4.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
