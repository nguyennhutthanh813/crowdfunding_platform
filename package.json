{
  "name": "crowdfunding-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Nền tảng gọi vốn cộng đồng — Crowdfunding Platform",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "corepack pnpm --filter @crowdfunding/web dev",
    "build:web": "corepack pnpm --filter @crowdfunding/web build",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "corepack pnpm --filter @crowdfunding/api prisma:generate",
    "db:push": "corepack pnpm --filter @crowdfunding/api prisma:push",
    "db:migrate": "corepack pnpm --filter @crowdfunding/api prisma:migrate",
    "db:studio": "corepack pnpm --filter @crowdfunding/api prisma:studio",
    "db:seed": "corepack pnpm --filter @crowdfunding/api prisma:seed",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "prettier": "^3.4.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.3.0",
    "rimraf": "^6.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
